---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ImageViewer from '../components/ImageViewer.astro';
import PageMotion from '../components/PageMotion.astro';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  active?: string;
  ogImage?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  active,
  ogImage = '/og.png',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = import.meta.env.PUBLIC_SITE_INDEXABLE !== 'true';
const fullTitle =
  title === 'Ayman Ashraf Mounir'
    ? `${title} — Software Engineer`
    : `${title} — Ayman Ashraf Mounir`;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ayman Ashraf Mounir',
  url: Astro.site?.href,
  jobTitle: 'Software Engineer',
  sameAs: [
    'https://github.com/aymanashrafmounir',
    'https://linkedin.com/in/aymanashrafmounir/',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={preview || noindex ? 'noindex, nofollow' : 'index, follow'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/AymanSansWeb-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/AymanSansWeb-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/AymanSansWeb-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/AymanSansWeb-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#F5F2EC" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <PageMotion />
    <div class="site-content">
      <a class="skip-link" href="#main">
        Skip to content
      </a>
      <SiteHeader active={active} />
      <main id="main" class="container">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <ImageViewer />
  </body>
</html>
