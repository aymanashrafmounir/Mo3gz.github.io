---
import SiteLayout from '../layouts/SiteLayout.astro';
import SkillGroups from '../components/SkillGroups.astro';
---

<SiteLayout
  title="About Ayman"
  description="Meet Ayman Ashraf Mounir, a Cairo-based software engineer focused on backend systems and complete product delivery."
  active="/about/"
>
  <section class="page-lead">
    <h1>About Ayman</h1>
  </section>
  <section class="about-introduction reading" aria-labelledby="about-focus">
    <h2 id="about-focus">
      Backend focus.
      <br />
      Complete product delivery.
    </h2>
    <p>
      I'm Ayman Ashraf Mounir, a Cairo-based Software Engineer. My work spans
      Java backend systems, cloud-native SaaS platforms and full-stack
      applications, from requirements and architecture to implementation,
      testing and deployment.
    </p>
    <p>
      I also contribute to AI evaluation and benchmarking, designing technical
      tasks and verification criteria that test reasoning, correctness and
      reliability.
    </p>
  </section>
  <img
    class="about-portrait section-space"
    src="/media/ayman-portrait-960.webp"
    srcset="/media/ayman-portrait-480.webp 480w, /media/ayman-portrait-960.webp 960w"
    sizes="(max-width: 407px) calc(100vw - 48px), 360px"
    width="360"
    height="480"
    alt="Ayman Ashraf Mounir"
    loading="lazy"
    decoding="async"
  />
  <section class="section-space" aria-labelledby="technical-strengths">
    <h2 class="section-title" id="technical-strengths">
      Technical strengths
    </h2>
    <SkillGroups />
    <div class="actions about-actions">
      <a class="button" href="/projects">
        View projects
      </a>
      <a class="button secondary" href="/contact">
        Contact
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .about-introduction h2 {
    margin: 0 0 32px;
    font-size: clamp(1.8rem, 3vw, 2.375rem);
    line-height: 1.3;
    font-weight: 600;
  }
  .about-introduction p {
    font-size: clamp(1.125rem, 1.7vw, 1.3125rem);
    line-height: 1.5;
    color: var(--muted);
  }
  .about-introduction p + p {
    margin-top: 32px;
  }
  .about-portrait {
    display: block;
    width: min(360px, 100%);
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 6px;
  }
  .about-actions {
    margin-top: 44px;
  }
</style>
