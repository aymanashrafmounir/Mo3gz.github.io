<dialog id="image-viewer" class="image-viewer" aria-labelledby="viewer-title">
  <h2 id="viewer-title" class="sr-only">
    Project screenshot
  </h2>
  <div class="viewer-toolbar">
    <p id="viewer-caption"></p>
    <div class="viewer-controls">
      <button type="button" data-zoom="out" aria-label="Zoom out">
        −
      </button>
      <button type="button" data-zoom="reset" aria-label="Reset zoom">
        100%
      </button>
      <button type="button" data-zoom="in" aria-label="Zoom in">
        +
      </button>
      <button type="button" id="viewer-close" aria-label="Close screenshot">
        Close <span aria-hidden="true">×</span>
      </button>
    </div>
  </div>
  <div id="viewer-canvas" class="viewer-canvas">
    <img id="viewer-image" alt="" />
  </div>
  <p class="viewer-hint">
    Use + / − to zoom. Drag or pinch to explore. Escape closes.
  </p>
</dialog>
<script>
  import '../scripts/gallery';
</script>
