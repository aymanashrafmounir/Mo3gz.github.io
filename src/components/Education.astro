---
import { education } from '../data/profile';
---

<div class="education">
  <h3>{education.degree}</h3>
  <p>{education.institution}</p>
  <p>{education.dates}</p>
</div>

<style>
  .education {
    max-width: 800px;
  }
  h3 {
    margin: 0 0 10px;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
  }
  p {
    margin: 6px 0 0;
    color: var(--muted);
    line-height: 1.5;
  }
</style>
