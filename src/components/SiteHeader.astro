---
interface Props {
  active?: string;
}
const { active } = Astro.props;
const current = (active ?? Astro.url.pathname).replace(/\/$/, '') || '/';
const links = [
  ['Projects', '/projects'],
  ['About', '/about'],
  ['Experience', '/experience'],
  ['Resume', '/resume'],
  ['Contact', '/contact'],
];
---

<header class="site-header container">
  <a class="wordmark" href="/">
    Ayman Ashraf Mounir
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {links.map(([label, href]) => (
      <a href={href} aria-current={current === href ? 'page' : undefined}>
        {label}
      </a>
    ))}
  </nav>
  <button
    class="menu-trigger"
    id="open-menu"
    type="button"
    aria-label="Open navigation"
    aria-controls="mobile-menu"
    aria-expanded="false"
    hidden
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" class="burger-icon">
      <path d="M3 6h18" />
      <path d="M3 12h18" />
      <path d="M3 18h18" />
    </svg>
  </button>
  <nav
    id="mobile-menu"
    class="mobile-menu"
    aria-label="Mobile navigation"
    hidden
  >
    {[['Home', '/'], ...links].map(([label, href]) => (
      <a href={href} aria-current={current === href ? 'page' : undefined}>
        <span>{label}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    ))}
  </nav>
</header>
<noscript>
  <nav
    class="no-script-nav container"
    aria-label="Navigation without JavaScript"
  >
    {links.map(([label, href]) => (
      <a href={href}>{label}</a>
    ))}
  </nav>
</noscript>
<script>
  const menu = document.querySelector<HTMLElement>('#mobile-menu')!;
  const trigger = document.querySelector<HTMLButtonElement>('#open-menu')!;
  const header = trigger.closest<HTMLElement>('.site-header')!;
  const menuLinks = menu.querySelectorAll<HTMLAnchorElement>('a');
  const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
  const desktopViewport = matchMedia('(min-width: 1200px)');
  let state: 'closed' | 'open' | 'closing' = 'closed';
  let animations: Animation[] = [];

  function cancelAnimations() {
    animations.forEach((animation) => animation.cancel());
    animations = [];
  }

  function syncDisclosureState() {
    const expanded = state === 'open';
    trigger.setAttribute('aria-expanded', String(expanded));
    trigger.setAttribute(
      'aria-label',
      expanded ? 'Close navigation' : 'Open navigation',
    );
    menuLinks.forEach((link) => {
      if (expanded) link.removeAttribute('tabindex');
      else link.tabIndex = -1;
    });
  }

  function sizeDropdown() {
    if (menu.hidden) return;
    const available =
      window.innerHeight - menu.getBoundingClientRect().top - 16;
    menu.style.setProperty(
      '--menu-available-height',
      `${Math.max(48, available)}px`,
    );
  }

  function finishClose() {
    cancelAnimations();
    state = 'closed';
    menu.hidden = true;
    syncDisclosureState();
  }

  function closeMenu() {
    if (state !== 'open') return;
    if (motionPreference.matches) {
      finishClose();
      return;
    }
    state = 'closing';
    syncDisclosureState();
    cancelAnimations();
    const closing = menu.animate(
      [
        { opacity: 1, transform: 'translateY(0) scale(1)' },
        { opacity: 0, transform: 'translateY(-6px) scale(.99)' },
      ],
      { duration: 150, easing: 'cubic-bezier(.4, 0, 1, 1)', fill: 'both' },
    );
    animations.push(closing);
    void closing.finished.then(finishClose, (error: unknown) => {
      if (!(error instanceof DOMException && error.name === 'AbortError')) {
        throw error;
      }
    });
  }

  function openMenu() {
    cancelAnimations();
    state = 'open';
    menu.hidden = false;
    syncDisclosureState();
    sizeDropdown();
    if (motionPreference.matches) return;
    animateDropdown();
    animateLinks();
  }

  function animateDropdown() {
    animations.push(
      menu.animate(
        [
          { opacity: 0, transform: 'translateY(-8px) scale(.985)' },
          { opacity: 1, transform: 'translateY(0) scale(1)' },
        ],
        { duration: 220, easing: 'cubic-bezier(.22, 1, .36, 1)' },
      ),
    );
  }

  function animateLinks() {
    menuLinks.forEach((link, index) => {
      animations.push(
        link.animate(
          [
            { opacity: 0, transform: 'translateY(-4px)' },
            { opacity: 1, transform: 'translateY(0)' },
          ],
          {
            duration: 180,
            delay: index * 15,
            easing: 'cubic-bezier(.22, 1, .36, 1)',
            fill: 'backwards',
          },
        ),
      );
    });
  }

  trigger.hidden = false;
  trigger.addEventListener('click', () => {
    if (state === 'open') closeMenu();
    else openMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || state !== 'open') return;
    event.preventDefault();
    trigger.focus({ preventScroll: true });
    closeMenu();
  });
  document.addEventListener('pointerdown', (event) => {
    if (!event.composedPath().includes(header)) closeMenu();
  });
  document.addEventListener('focusin', (event) => {
    if (event.target instanceof Node && !header.contains(event.target)) {
      closeMenu();
    }
  });
  window.addEventListener('blur', closeMenu);
  menu.addEventListener('focusin', () => {
    if (state === 'closing') openMenu();
    cancelAnimations();
  });
  menu.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) {
      // Keep the anchor rendered until its native click activation completes.
      window.setTimeout(finishClose, 0);
    }
  });
  motionPreference.addEventListener('change', () => {
    if (!motionPreference.matches) return;
    cancelAnimations();
    if (state === 'closing') finishClose();
  });
  desktopViewport.addEventListener('change', () => {
    if (desktopViewport.matches) finishClose();
  });
  window.addEventListener('resize', sizeDropdown);
  window.addEventListener('pagehide', finishClose);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) finishClose();
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
  }
  .menu-trigger {
    display: none;
    width: 48px;
    height: 48px;
    padding: 12px;
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--text);
    background: transparent;
    transition:
      color 160ms,
      border-color 160ms,
      background-color 160ms;
  }
  .menu-trigger svg,
  .mobile-menu svg {
    display: block;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .menu-trigger[aria-expanded='true'] {
    color: var(--rust);
    border-color: var(--rust);
    background: var(--surface);
  }
  .burger-icon path {
    transform-origin: 12px 12px;
    transition:
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 140ms;
  }
  .menu-trigger[aria-expanded='true'] .burger-icon path:first-child {
    transform: rotate(45deg) translateY(6px);
  }
  .menu-trigger[aria-expanded='true'] .burger-icon path:nth-child(2) {
    opacity: 0;
  }
  .menu-trigger[aria-expanded='true'] .burger-icon path:last-child {
    transform: rotate(-45deg) translateY(-6px);
  }
  .mobile-menu {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: min(100%, 360px);
    max-height: var(--menu-available-height, calc(100dvh - 116px));
    overflow-y: auto;
    overscroll-behavior: contain;
    display: grid;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    box-shadow: 0 16px 32px rgb(38 37 31 / 0.12);
    transform-origin: top right;
  }
  .mobile-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    padding: 10px 14px;
    border-radius: 4px;
    font-size: 18px;
    font-weight: 500;
    transition:
      color 160ms,
      background-color 160ms;
  }
  .mobile-menu a[aria-current] {
    color: var(--rust);
    background: var(--surface);
  }
  .mobile-menu svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    opacity: 0.55;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (max-width: 1199px) {
    .site-header {
      flex-wrap: nowrap;
    }
    .wordmark {
      flex: 1;
    }
    .menu-trigger {
      display: grid;
      place-content: center;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .menu-trigger:hover,
    .mobile-menu a:hover {
      color: var(--rust);
      background: var(--surface);
    }
    .menu-trigger:hover {
      border-color: var(--rust);
    }
    .mobile-menu a:hover svg {
      transform: translateX(3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .burger-icon path,
    .mobile-menu svg {
      transition: none;
    }
    .mobile-menu a:hover svg {
      transform: none;
    }
  }
</style>
