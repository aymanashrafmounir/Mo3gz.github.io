{
  "name": "ayman-portfolio-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "dev": "npm run prepare:content && astro dev --host 127.0.0.1",
    "build": "npm run prepare:content && astro build",
    "build:preview": "node scripts/build-preview.mjs",
    "deploy:preview": "npm run build:preview && wrangler pages deploy ./output/preview-dist --branch review --commit-dirty=true",
    "build:production": "node scripts/build-production.mjs",
    "deploy:production": "npm run build:production && wrangler pages deploy ./output/production-dist --project-name ayman-portfolio-v2 --branch main --commit-dirty=true",
    "check": "astro check",
    "lint": "prettier --check src scripts astro.config.mjs package.json tsconfig.json wrangler.json",
    "format": "prettier --write src scripts astro.config.mjs package.json tsconfig.json wrangler.json",
    "preview": "astro preview --host 127.0.0.1",
    "test:smoke": "node scripts/verify-site.mjs",
    "test:acceptance": "node scripts/verify-acceptance.mjs",
    "test:media": "node scripts/verify-media.mjs",
    "test:fonts": "node scripts/verify-fonts.mjs",
    "test:performance": "node scripts/lighthouse-audit.mjs"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "axe-core": "4.14.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wawoff2": "2.0.1",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
